<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css" />
    <title>New Message</title>
</head>
<body>
    <header>
        <h1>New Message</h1>
    </header>
    <main>
        <form method="POST" action="/new">
            <div>
                <label for="msgName">Your name:</label>
                <input type="text" id="msgName" name="msgName" />
            </div>
            <div>
                <label for="msgText">Text:</label>
                 <textarea id="msgText" name="msgText" rows="4" cols="37"></textarea>
            </div>
            <div>
                <button>Submit</button>
                <button>Cancel</button>
            </div>
        </form>
        <a href="/">Home</a>
    </main>
</body>
</html>