<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css" />
    <title>Home</title>
</head>
<body>
    <header>
        <h1>My Message Board</h1>
    </header>
    <main>
        <ul class="message-list">
            <% messages.forEach((message) => { %>
                <%- include("message", { message: message }); %>
            <% }); %>
        </ul>
    </main>
</body>
</html>